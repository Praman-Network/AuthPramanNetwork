# Secure Private Key configuration for contract deployment
# Rename this file to '.env' and insert your private key. Do not commit '.env' to GitHub.
PRIVATE_KEY=0x_insert_your_private_key_here

# Supabase configuration for API key & origin whitelist validation
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here